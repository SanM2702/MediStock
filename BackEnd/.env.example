# ==================== CLOUDINARY ====================
# Variables de Cloudinary para almacenamiento de imágenes
# Obtén tus credenciales en: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== JWT ====================
# Clave secreta para JWT (cambia esto en producción)
SECRET_KEY=your-secret-key-change-in-production

# ==================== EMAIL ====================
# Configuración de EmailJS para envío de emails
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# ==================== DATABASE ====================
# SQLite local
DATABASE_URL=sqlite:///./medistock.db

# SQLite con disco persistente en Render (si configuras un Disk en /var/data)
# DATABASE_URL=sqlite:////var/data/medistock.db

# ==================== GROQ AI - CHATBOT ====================
# IMPORTANTE: Esta API key debe ser protegida y nunca expuesta al frontend
# 1. Obtén tu API key en: https://console.groq.com/keys
# 2. Modelo utilizado: llama-3.1-8b-instant
#    - Respuestas rápidas (< 1 segundo)
#    - Optimizado para respuestas cortas (~80 tokens)
#    - Bajo costo por API
# 3. Documentación: https://console.groq.com/docs
# 4. API Base: https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your_api_key_here
